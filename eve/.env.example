# Brain
EVE_MODEL=qwen3:8b
EVE_OLLAMA_HOST=http://127.0.0.1:11434

# Workspace and memory
EVE_WORKSPACE=./workspace
EVE_MEMORY=./data/memory.json
EVE_SAFE_MODE=true
EVE_MAX_READ_BYTES=262144

# Voice
EVE_VOICE_ENABLED=true
EVE_LISTEN_SECONDS=6
EVE_STT_MODEL=small
EVE_STT_DEVICE=auto
EVE_STT_COMPUTE=int8
EVE_STT_GPU_COMPUTE=float16
EVE_STT_SAMPLE_RATE=16000

# Piper is local TTS. Set the executable and a downloaded Piper voice model.
EVE_PIPER_BIN=piper
EVE_PIPER_MODEL=
